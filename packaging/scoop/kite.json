{
    "##": "Filled in and pushed to grxtor/scoop-bucket by .github/workflows/publish.yml. Scoop updates Kite: updates-managed-by.txt makes Kite only announce new releases, and its updater refuses to install them.",
    "version": "@VERSION@",
    "description": "Minecraft launcher with multi-instance management",
    "homepage": "https://kiteclient.com",
    "license": "Apache-2.0 AND LGPL-3.0-only AND LGPL-2.1-only AND OFL-1.1 AND MIT",
    "suggest": {
        "vcredist": "extras/vcredist2022"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/grxtor/kite/releases/download/@TAG@/Kite-Windows-MSVC-Qt6-@TAG@.zip",
            "hash": "@SHA256:Kite-Windows-MSVC-Qt6-@TAG@.zip@"
        },
        "arm64": {
            "url": "https://github.com/grxtor/kite/releases/download/@TAG@/Kite-Windows-MSVC-Qt6-arm64-@TAG@.zip",
            "hash": "@SHA256:Kite-Windows-MSVC-Qt6-arm64-@TAG@.zip@"
        }
    },
    "pre_install": "Set-Content -LiteralPath \"$dir\\updates-managed-by.txt\" -Value 'scoop' -Encoding ascii",
    "bin": "kite.exe",
    "shortcuts": [
        [
            "kite.exe",
            "Kite"
        ]
    ]
}
