---
// SPDX-FileCopyrightText: 2026 grxtor
// SPDX-License-Identifier: Apache-2.0
//
// A real screenshot of Kite. With `focus` it shows one region of the
// screen, enlarged and fading out at the bottom, the way a bento card
// shows a fragment of the app rather than the whole window.
import { Picture } from 'astro:assets';
import { SCREENS } from '../data/content';
import { SCREENSHOT_SIZES, SCREENSHOT_WIDTHS, focusedSizes, type Focus } from '../lib/imaging';
import type { Locale } from '../i18n';
import type { ScreenId } from '../i18n/types';

interface Props {
  locale: Locale;
  screen: ScreenId;
  alt: string;
  size?: keyof typeof SCREENSHOT_SIZES;
  /** Show only this region of the screen; see Focus. */
  focus?: Focus;
  /** The kite's cut on the frame: only for the one big app window. */
  cut?: boolean;
  /** Load immediately instead of lazily. Use for the first screenshot on a page. */
  priority?: boolean;
}

const { locale, screen, alt, size = 'card', focus, cut = false, priority = false } = Astro.props;
const style = focus
  ? `--zoom: ${focus.zoom}; --x: ${focus.x}; --y: ${focus.y}; --ratio: ${focus.ratio};`
  : undefined;
---

<div
  class:list={['shot', focus && 'focused', focus?.fade !== false && 'faded', cut && 'cut']}
  style={style}
>
  <Picture
    src={SCREENS[locale][screen]}
    alt={alt}
    formats={['avif', 'webp']}
    fallbackFormat="webp"
    widths={SCREENSHOT_WIDTHS}
    sizes={focus ? focusedSizes(focus.zoom) : SCREENSHOT_SIZES[size]}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding={priority ? 'sync' : 'async'}
  />
</div>

<style>
  .shot {
    border: 1px solid var(--border-shot);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-shot);
    overflow: hidden;
  }
  .shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .cut {
    border-top-right-radius: var(--radius-cut);
  }

  /* A region of the screen: the picture is enlarged by --zoom and moved so
     the point (--x, --y), as fractions of the picture, sits top-left. */
  .focused {
    position: relative;
    aspect-ratio: var(--ratio);
    box-shadow: none;
  }
  .faded {
    mask-image: linear-gradient(to bottom, #000 62%, transparent);
  }
  .focused :global(img) {
    position: absolute;
    top: 0;
    left: 0;
    width: calc(var(--zoom) * 100%);
    max-width: none;
    transform: translate(calc(var(--x) * -100%), calc(var(--y) * -100%));
  }
</style>
