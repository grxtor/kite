---
// SPDX-FileCopyrightText: 2026 grxtor
// SPDX-License-Identifier: Apache-2.0
import Backdrop from '../components/Backdrop.astro';
import CompareSection from '../components/CompareSection.astro';
import FaqSection from '../components/FaqSection.astro';
import FeatureCard from '../components/FeatureCard.astro';
import HeroDownload from '../components/HeroDownload.astro';
import NativeSection from '../components/NativeSection.astro';
import PlatformCards from '../components/PlatformCards.astro';
import Screenshot from '../components/Screenshot.astro';
import { FEATURE_CARDS, HERO_BACKDROP } from '../data/content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDictionary, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
---

<BaseLayout
  locale={locale}
  route="/"
  title={t.meta.home.title}
  description={t.meta.home.description}
>
  <section class:list={['hero', HERO_BACKDROP && 'has-backdrop']}>
    {HERO_BACKDROP && <Backdrop image={HERO_BACKDROP} />}
    <div class="container">
      <div class="intro">
        <h1>{t.hero.title}</h1>
        <p class="lead">{t.hero.lead}</p>
        <HeroDownload locale={locale} />
      </div>
      <div class="hero-shot">
        <Screenshot
          locale={locale}
          screen="home"
          alt={t.hero.screenshotAlt}
          size="hero"
          cut
          priority
        />
      </div>
    </div>
  </section>

  <section class="section features" id="features" aria-labelledby="features-title">
    <div class="container">
      <div class="head">
        <h2 id="features-title">{t.features.title}</h2>
        <p class="lead">{t.features.lead}</p>
      </div>
      <div class="bento">
        {
          FEATURE_CARDS.map((card) => (
            <FeatureCard
              locale={locale}
              screen={card.screen}
              focus={card.focus}
              wide={card.wide}
              title={t.features.rows[card.key].title}
              text={t.features.rows[card.key].text}
              alt={t.features.rows[card.key].alt}
            />
          ))
        }
      </div>
    </div>
  </section>

  <NativeSection locale={locale} />
  <CompareSection locale={locale} />
  <FaqSection locale={locale} />

  <section class="section band" aria-labelledby="band-title">
    <div class="container">
      <div class="head">
        <h2 id="band-title">{t.platformsBand.title}</h2>
        <p class="lead">{t.platformsBand.lead}</p>
      </div>
      <PlatformCards locale={locale} heading="h3" anchors={false} />
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-top: var(--space-9);
  }
  .intro {
    display: grid;
    justify-items: center;
    gap: var(--space-5);
    max-width: 48rem;
    margin-inline: auto;
    text-align: center;
  }
  h1 {
    font-size: var(--text-display);
    line-height: 1.04;
    letter-spacing: var(--tracking-h1);
  }
  .intro .lead {
    max-width: 40rem;
  }
  .hero-shot {
    max-width: var(--hero-shot-max);
    margin: var(--space-8) auto 0;
  }

  .features,
  .band {
    scroll-margin-top: var(--header-height);
  }
  .head {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    max-width: 46rem;
    margin: 0 auto var(--space-7);
    text-align: center;
  }
  .bento {
    display: grid;
    gap: var(--space-5);
  }
  @media (min-width: 900px) {
    .bento {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
  }
</style>
