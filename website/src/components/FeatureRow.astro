// SPDX-License-Identifier: Apache-2.0
import Screenshot from './Screenshot.astro';
import type { Locale } from '../i18n';
import type { ScreenId } from '../i18n/en';

interface Props {
  locale: Locale;
  screen: ScreenId;
  title: string;
  text: string;
  alt: string;
  /** Puts the screenshot on the left on wide screens. */
  flip?: boolean;
}

const { locale, screen, title, text, alt, flip = false } = Astro.props;
---

<div class:list={['row', flip && 'flip']}>
  <div class="copy">
    <h3>{title}</h3>
    <p class="lead">{text}</p>
  </div>
  <div class="media">
    <Screenshot locale={locale} screen={screen} alt={alt} size="row" />
  </div>
</div>

<style>
  .row {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }
  .copy {
    display: grid;
    gap: var(--space-3);
    max-width: 46ch;
  }

  @media (min-width: 900px) {
    .row {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
      gap: var(--space-8);
    }
    .flip .copy {
      order: 2;
    }
    .flip {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    }
    .flip .media {
      order: 1;
    }
  }
</style>
