// SPDX-License-Identifier: Apache-2.0
import Button from './Button.astro';
import LanguageSwitch from './LanguageSwitch.astro';
import Logo from './Logo.astro';
import { getDictionary, localePath, type Locale, type Route } from '../i18n';
import { HEADER_LOGO_SIZE_PX } from '../lib/imaging';

interface Props {
  locale: Locale;
  route: Route;
}

const { locale, route } = Astro.props;
const t = getDictionary(locale);
const home = localePath(locale, '/');
const downloadPath = localePath(locale, '/download');
---

<header class="header">
  <div class="container">
    <div class="bar">
      <a class="brand" href={home} aria-label={t.nav.homeLabel}>
        <Logo size={HEADER_LOGO_SIZE_PX} />
      </a>
      <nav class="nav" aria-label={t.nav.mainLabel}>
        <a class="link" href={`${home}#features`}>{t.nav.features}</a>
        <a class="link" href={`${home}#compare`}>{t.nav.compare}</a>
        <a class="link" href={`${home}#faq`}>{t.nav.faq}</a>
      </nav>
      <div class="actions">
        <LanguageSwitch locale={locale} route={route} />
        <Button href={downloadPath} pill>{t.nav.download}</Button>
      </div>
    </div>
  </div>
</header>

<style>
  /* A floating bar of liquid glass: the page scrolls under it. */
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    height: var(--header-height);
    padding-top: var(--space-3);
  }
  /* Three columns: the mark and the button sit the same distance from
     each end, and the links stay in the true middle. */
  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: var(--header-bar-height);
    padding-inline: var(--header-bar-inset);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-pill);
    background: var(--glass-sheen), var(--glass-fill);
    box-shadow: var(--glass-edge-top), var(--glass-edge-bottom), var(--glass-shadow);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
  }
  .brand {
    grid-column: 1;
    justify-self: start;
    display: flex;
    align-items: center;
    border-radius: var(--radius-md);
    text-decoration: none;
  }
  .nav {
    display: none;
    grid-column: 2;
    align-items: center;
    gap: var(--space-6);
  }
  .link {
    color: var(--text-secondary);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
  }
  .link:hover {
    color: var(--text);
  }
  .actions {
    grid-column: 3;
    justify-self: end;
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  /* Phones keep the mark, the language switch and the Download button. */
  @media (min-width: 720px) {
    .nav {
      display: flex;
    }
  }
</style>
