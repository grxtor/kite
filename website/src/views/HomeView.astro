// SPDX-License-Identifier: Apache-2.0
import CompareSection from '../components/CompareSection.astro';
import FaqSection from '../components/FaqSection.astro';
import DawnBand from '../components/DawnBand.astro';
import FeatureCard from '../components/FeatureCard.astro';
import NativeSection from '../components/NativeSection.astro';
import SectionHead from '../components/SectionHead.astro';
import SkyHero from '../components/SkyHero.astro';
import { FEATURE_CARDS } from '../data/content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDictionary, type Locale } from '../i18n';
import { homeStructuredData } from '../lib/structured-data';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const site = Astro.site ?? new URL('https://kiteclient.com');
---

<BaseLayout
  locale={locale}
  route="/"
  title={t.meta.home.title}
  description={t.meta.home.description}
  structuredData={homeStructuredData(locale, site)}
>
  <SkyHero locale={locale} />

  <section class="section features" id="features" aria-labelledby="features-title">
    <div class="container">
      <SectionHead id="features-title" title={t.features.title} lead={t.features.lead} />
      <div class="bento">
        {
          FEATURE_CARDS.map((card) => (
            <FeatureCard
              locale={locale}
              screen={card.screen}
              focus={card.focus}
              wide={card.wide}
              title={t.features.rows[card.key].title}
              text={t.features.rows[card.key].text}
              alt={t.features.rows[card.key].alt}
            />
          ))
        }
      </div>
    </div>
  </section>

  <NativeSection locale={locale} />
  <CompareSection locale={locale} />
  <FaqSection locale={locale} />

  <DawnBand locale={locale} />
</BaseLayout>

<style>
  .features {
    scroll-margin-top: var(--header-height);
  }
  .bento {
    display: grid;
    gap: var(--space-5);
  }
  @media (min-width: 900px) {
    .bento {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
  }
</style>
