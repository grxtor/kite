// SPDX-License-Identifier: Apache-2.0
//
// A full-bleed in-game screenshot behind a section. A neutral scrim keeps
// text on top readable and fades the picture into the canvas at the bottom.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { BACKDROP_SIZES, BACKDROP_WIDTHS } from '../lib/imaging';

interface Props {
  image: ImageMetadata;
}

const { image } = Astro.props;
---

<div class="backdrop" aria-hidden="true">
  <Picture
    src={image}
    alt=""
    formats={['avif', 'webp']}
    fallbackFormat="webp"
    widths={BACKDROP_WIDTHS}
    sizes={BACKDROP_SIZES}
    loading="eager"
    fetchpriority="high"
  />
</div>

<style>
  .backdrop {
    position: absolute;
    inset: 0 0 auto;
    height: var(--backdrop-height);
    z-index: -1;
    overflow: hidden;
  }
  .backdrop :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .backdrop::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      var(--scrim-top) 0%,
      var(--scrim-mid) 55%,
      var(--canvas) 100%
    );
  }
</style>
