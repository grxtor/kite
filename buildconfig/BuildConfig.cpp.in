#include "BuildConfig.h"
#include <QObject>

const Config BuildConfig;

Config::Config()
{
	// Name and copyright
	KITE_NAME = "@Kite_Name@";
	KITE_BINARY = "@Kite_AppBinaryName@";
	KITE_DISPLAYNAME = "@Kite_DisplayName@";
	KITE_COPYRIGHT = "@Kite_Copyright@";
	KITE_DOMAIN = "@Kite_Domain@";
	KITE_CONFIGFILE = "@Kite_ConfigFile@";
	KITE_GIT = "@Kite_Git@";
	KITE_APPID = "@Kite_AppID@";
	KITE_ENVNAME = "@Kite_EnvName@";

	USER_AGENT = "@Kite_UserAgent@";
	USER_AGENT_UNCACHED = USER_AGENT + " (Uncached)";

	// Version information
	VERSION_MAJOR = @Kite_VERSION_MAJOR@;
	VERSION_MINOR = @Kite_VERSION_MINOR@;
	VERSION_HOTFIX = @Kite_VERSION_HOTFIX@;
	VERSION_BUILD = @Kite_VERSION_BUILD@;

	BUILD_PLATFORM = "@Kite_BUILD_PLATFORM@";
	BUILD_ARTIFACT = "@Kite_BUILD_ARTIFACT@";
	BUILD_DATE = "@Kite_BUILD_TIMESTAMP@";
	COMPILER_NAME = "@Kite_COMPILER_NAME@";
	COMPILER_VERSION = "@Kite_COMPILER_VERSION@";
	COMPILER_TARGET_SYSTEM = "@Kite_COMPILER_TARGET_SYSTEM@";
	COMPILER_TARGET_SYSTEM_VERSION = "@Kite_COMPILER_TARGET_SYSTEM_VERSION@";
	COMPILER_TARGET_SYSTEM_PROCESSOR = "@Kite_COMPILER_TARGET_PROCESSOR@";
	UPDATER_GITHUB_REPO = "@Kite_UPDATER_GITHUB_REPO@";
	UPDATE_CHANNEL = "@Kite_UPDATE_CHANNEL_EFFECTIVE@";
	NOTIFICATION_URL = "@Kite_NOTIFICATION_URL@";
	FULL_VERSION_STR =
		"@Kite_VERSION_MAJOR@.@Kite_VERSION_MINOR@.@Kite_VERSION_BUILD@";

	GIT_COMMIT = "@Kite_GIT_COMMIT@";
	GIT_REFSPEC = "@Kite_GIT_REFSPEC@";
	GIT_TAG = "@Kite_GIT_TAG@";

	UPDATER_ENABLED =
		!UPDATER_GITHUB_REPO.isEmpty() && !BUILD_ARTIFACT.isEmpty();

	// VERSION_CHANNEL is still populated from the git branch for informational
	// use.
	if (GIT_REFSPEC.startsWith("refs/heads/")) {
		VERSION_CHANNEL = GIT_REFSPEC;
		VERSION_CHANNEL.remove("refs/heads/");
	} else {
		VERSION_CHANNEL = QObject::tr("custom");
	}

	VERSION_STR = "@Kite_VERSION_STRING@";
	MSAClientID = "@Kite_MICROSOFT_CLIENT_ID@";
	NEWS_RSS_URL = "@Kite_NEWS_RSS_URL@";
	NEWS_EXTRA_FEEDS = "@Kite_NEWS_EXTRA_FEEDS@";
	PASTE_EE_KEY = "@Kite_PASTE_EE_API_KEY@";
	IMGUR_CLIENT_ID = "@Kite_IMGUR_CLIENT_ID@";
	META_URL = "@Kite_META_URL@";
	TRANSLATIONS_BASE_URL = "@Kite_TRANSLATIONS_URL@";
	CURSEFORGE_API_KEY = "@Kite_CURSEFORGE_API_KEY@";

	BUG_TRACKER_URL = "@Kite_BUG_TRACKER_URL@";
	DISCORD_URL = "@Kite_DISCORD_URL@";
	SUBREDDIT_URL = "@Kite_SUBREDDIT_URL@";
	PATREON_URL = "@Kite_Patreon_Url@";

	// Feature flags (GitLab Unleash-compatible backend).
	UNLEASH_URL = "@Kite_UNLEASH_URL@";
	UNLEASH_INSTANCE_ID = "@Kite_UNLEASH_INSTANCE_ID@";
	UNLEASH_APP_NAME = "@Kite_UNLEASH_APP_NAME@";
	FEATURE_FLAGS_ENABLED =
		!UNLEASH_URL.isEmpty() && !UNLEASH_INSTANCE_ID.isEmpty();
}

QString Config::printableVersionString() const
{
	QString vstr =
		QString("%1.%2.%3")
			.arg(QString::number(VERSION_MAJOR), QString::number(VERSION_MINOR),
				 QString::number(VERSION_HOTFIX));

	if (!GIT_TAG.isEmpty() && !GIT_TAG.endsWith("-NOTFOUND")) {
		return vstr;
	}

	return vstr;
}

QString Config::compilerID() const
{
	if (COMPILER_VERSION.isEmpty())
		return COMPILER_NAME;
	return QStringLiteral("%1 - %2").arg(COMPILER_NAME).arg(COMPILER_VERSION);
}

QString Config::systemID() const
{
	return QStringLiteral("%1 %2 %3")
		.arg(COMPILER_TARGET_SYSTEM, COMPILER_TARGET_SYSTEM_VERSION,
			 COMPILER_TARGET_SYSTEM_PROCESSOR);
}
