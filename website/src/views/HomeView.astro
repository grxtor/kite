---
// SPDX-FileCopyrightText: 2026 grxtor
// SPDX-License-Identifier: Apache-2.0
import Backdrop from '../components/Backdrop.astro';
import Button from '../components/Button.astro';
import CompareSection from '../components/CompareSection.astro';
import FeatureCard from '../components/FeatureCard.astro';
import NativeSection from '../components/NativeSection.astro';
import Screenshot from '../components/Screenshot.astro';
import { FEATURE_ROWS, HERO_BACKDROP } from '../data/content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDictionary, localePath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const downloadPath = localePath(locale, '/download');
---

<BaseLayout
  locale={locale}
  route="/"
  title={t.meta.home.title}
  description={t.meta.home.description}
>
  <section class:list={['hero', HERO_BACKDROP && 'has-backdrop']}>
    {HERO_BACKDROP && <Backdrop image={HERO_BACKDROP} />}
    <div class="container hero-grid">
      <div class="intro">
        <h1>{t.hero.title}</h1>
        <p class="lead">{t.hero.lead}</p>
        <div class="actions">
          <Button href={downloadPath} size="lg">{t.hero.primaryCta}</Button>
          <Button href="#compare" variant="secondary" size="lg">{t.hero.secondaryCta}</Button>
        </div>
        <p class="note">{t.hero.note}</p>
      </div>
      <div class="hero-shot">
        <Screenshot locale={locale} screen="home" alt={t.hero.screenshotAlt} size="hero" priority />
      </div>
    </div>
  </section>

  <NativeSection locale={locale} />

  <section class="section features" id="features" aria-labelledby="features-title">
    <div class="container">
      <div class="features-head">
        <h2 id="features-title">{t.features.title}</h2>
        <p class="lead">{t.features.lead}</p>
      </div>
      <div class="cards">
        {
          FEATURE_ROWS.map((row) => (
            <FeatureCard
              locale={locale}
              screen={row.screen}
              title={t.features.rows[row.key].title}
              text={t.features.rows[row.key].text}
              alt={t.features.rows[row.key].alt}
            />
          ))
        }
      </div>
    </div>
  </section>

  <CompareSection locale={locale} />

  <section class="closing" aria-labelledby="closing-title">
    <div class="container">
      <div class="closing-bar">
        <div>
          <h2 id="closing-title">{t.closing.title}</h2>
          <p class="closing-text">{t.closing.text}</p>
        </div>
        <Button href={downloadPath} size="lg">{t.closing.cta}</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow-x: clip;
    padding-block: var(--space-8);
  }
  .has-backdrop {
    padding-top: var(--space-9);
  }
  .hero-grid {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }
  .intro {
    display: grid;
    gap: var(--space-5);
    max-width: 38rem;
  }
  h1 {
    font-size: var(--text-display);
    line-height: 1.04;
    letter-spacing: var(--tracking-h1);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }
  .note {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
  /* On wide screens the screenshot runs past the right edge of the page. */
  @media (min-width: 1080px) {
    .hero-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
    .hero-shot {
      width: var(--hero-shot-bleed);
    }
  }

  .features {
    scroll-margin-top: var(--header-height);
  }
  .features-head {
    display: grid;
    gap: var(--space-4);
    max-width: 46rem;
    margin-bottom: var(--space-7);
  }
  .cards {
    display: grid;
    gap: var(--space-5);
  }
  @media (min-width: 900px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .closing {
    padding-bottom: var(--space-section);
  }
  .closing-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--surface);
  }
  .closing-text {
    margin-top: var(--space-2);
    color: var(--text-secondary);
  }
</style>
