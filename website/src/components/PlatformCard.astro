---
// SPDX-FileCopyrightText: 2026 grxtor
// SPDX-License-Identifier: Apache-2.0
//
// One platform: the system's name is the picture, set large in the serif.
import Button from './Button.astro';

interface Props {
  name: string;
  detail: string;
  /** Null while the build for this system is not published. */
  href: string | null;
  buttonText: string;
  /** Text shown instead of the button label when there is no link yet. */
  unavailableText: string;
  buttonLabel: string;
  /** Anchor for links such as /download#macos. */
  id?: string;
  /** h2 on the download page, h3 inside a section on the home page. */
  heading?: 'h2' | 'h3';
  /** `sky` for a card that sits on the sky: glass on white, not on night. */
  tone?: 'night' | 'sky';
}

const {
  name,
  detail,
  href,
  buttonText,
  unavailableText,
  buttonLabel,
  id,
  heading = 'h2',
  tone = 'night',
} = Astro.props;
const Heading = heading;
const sky = tone === 'sky';
---

<li class:list={['card', sky ? 'on-sky' : 'panel']} id={id}>
  <Heading class="name">{name}</Heading>
  <p>{detail}</p>
  <div class="action">
    {
      href ? (
        <Button href={href} size="lg" block variant={sky ? 'light' : 'primary'} label={buttonLabel}>
          {buttonText}
        </Button>
      ) : (
        <Button disabled size="lg" block>
          {unavailableText}
        </Button>
      )
    }
  </div>
</li>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-6);
    border-radius: var(--radius-xl);
    scroll-margin-top: calc(var(--header-height) + var(--space-5));
  }
  .name {
    font-size: var(--text-os);
    letter-spacing: var(--tracking-h2);
  }
  p {
    color: var(--text-secondary);
  }
  .action {
    margin-top: auto;
    padding-top: var(--space-6);
  }

  .on-sky {
    border: 1px solid var(--sky-glass-border);
    background: var(--sky-glass-fill);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 30%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    backdrop-filter: blur(16px) saturate(140%);
    /* Read by Button's disabled state. */
    --btn-off-border: var(--on-sky-border);
    --btn-off-color: var(--on-sky-muted);
  }
  .on-sky .name {
    color: var(--on-sky);
  }
  .on-sky p {
    color: var(--on-sky-secondary);
  }
</style>
