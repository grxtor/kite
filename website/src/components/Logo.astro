// SPDX-License-Identifier: Apache-2.0
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { LOGO_SIZE_PX } from '../lib/imaging';
---

<span class="logo">
  <Image
    src={logo}
    width={LOGO_SIZE_PX}
    height={LOGO_SIZE_PX}
    densities={[1, 2]}
    alt=""
    loading="eager"
    decoding="async"
  />
  <span class="word">Kite</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text);
  }
  .logo :global(img) {
    display: block;
  }
  .word {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: var(--tracking-h3);
  }
</style>
